<project name="Loki" default="build" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant"
         xmlns:if="ant:if" xmlns:unless="ant:unless">
    <property environment="env"/>
    <property name="group" value="org.unmojang"/>
    <property name="artifact" value="Loki"/>
    <property name="version" value="2.6.4"/>
    <property name="asm.version" value="9.10.1"/>
    <property name="ivy.version" value="2.4.0"/>

    <condition property="java_home" value="${env.JDK8_HOME}">
        <isset property="env.JDK8_HOME"/>
    </condition>

    <condition property="java_home" value="${env.JAVA_HOME}">
        <not>
            <isset property="java_home"/>
        </not>
    </condition>

    <fail message="Neither JDK8_HOME nor JAVA_HOME is set">
        <condition>
            <not>
                <isset property="java_home"/>
            </not>
        </condition>
    </fail>

    <property file="loki.properties"/>

    <property name="src.dir" value="src/main/java"/>
    <property name="res.dir" value="src/main/resources"/>

    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="lib.dir" value="${build.dir}/lib"/>
    <property name="tools.dir" value="${build.dir}/tools"/>
    <property name="dist.dir" value="${build.dir}/dist"/>
    <property name="temp.dir" value="${build.dir}/temp"/>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <mkdir dir="${temp.dir}"/>
    </target>

    <target name="ivy" description="Fetch Apache Ivy">
        <mkdir dir="${user.home}/.ant/lib"/>
        <get dest="${user.home}/.ant/lib/ivy.jar" src="https://repo1.maven.org/maven2/org/apache/ivy/ivy/${ivy.version}/ivy-${ivy.version}.jar"/>
    </target>

    <target name="resolve" depends="init">
        <ivy:retrieve pattern="${lib.dir}/[artifact]-[revision].[ext]"
                      conf="compile,runtime"/>

        <ivy:retrieve pattern="${tools.dir}/[artifact]-[revision].[ext]"
                      conf="tools"/>
    </target>

    <path id="cp">
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
    </path>

    <target name="compile" depends="resolve">
        <echo>Building with JDK: ${java_home}</echo>

        <copy todir="${classes.dir}">
            <fileset dir="${res.dir}" erroronmissingdir="false"/>
        </copy>

        <javac srcdir="${src.dir}"
               destdir="${classes.dir}"
               fork="true"
               executable="${java_home}/bin/javac"
               source="${javaTarget}"
               target="${javaTarget}"
               encoding="UTF-8"
               includeantruntime="false"
               classpathref="cp">

            <compilerarg value="-Xlint:all"/>
            <compilerarg value="-Xlint:-deprecation"/>
            <compilerarg value="-Xlint:-options"/>
        </javac>

    </target>

    <target name="test" depends="compile" description="Run Loki's tests">
        <!-- From scratch every time. These take a second to build, and javac's own up-to-date
             check goes by timestamp, so classes left by a different JDK are quietly kept and then
             refuse to run: "class file version 65.0" under a JDK that speaks 52. -->
        <delete dir="${build.dir}/test-classes"/>
        <delete dir="${build.dir}/test-stubs"/>
        <delete dir="${build.dir}/test-netty"/>
        <mkdir dir="${build.dir}/test-classes"/>
        <mkdir dir="${build.dir}/test-stubs"/>
        <mkdir dir="${build.dir}/test-netty"/>

        <!-- No source/target here on purpose. Tests are never shipped, so they only have to run
             on the JDK doing the building, and pinning them to javaTarget would break `ant test`
             on any JDK that has dropped support for it. -->

        <!-- Netty's shape: the interface names and packages NettyBridge resolves against. Loki
             never compiles against Netty, so the tests supply just enough of it to run a handler. -->
        <javac srcdir="src/test/netty" destdir="${build.dir}/test-netty" fork="true"
               executable="${java_home}/bin/javac" encoding="UTF-8" includeantruntime="false"/>

        <!-- Stand-ins for classes Loki patches but does not depend on, kept out of the test
             classpath so the tests load the patched bytes rather than these -->
        <javac srcdir="src/test/stubs" destdir="${build.dir}/test-stubs" fork="true"
               executable="${java_home}/bin/javac" encoding="UTF-8" includeantruntime="false">
            <classpath>
                <pathelement location="${build.dir}/test-netty"/>
            </classpath>
        </javac>

        <javac srcdir="src/test/java" destdir="${build.dir}/test-classes" fork="true"
               executable="${java_home}/bin/javac" encoding="UTF-8" includeantruntime="false">
            <classpath>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${build.dir}/test-netty"/>
                <path refid="cp"/>
            </classpath>
        </javac>

        <path id="test.classpath">
            <pathelement location="${classes.dir}"/>
            <pathelement location="${build.dir}/test-classes"/>
            <pathelement location="${build.dir}/test-netty"/>
            <path refid="cp"/>
        </path>

        <java classname="ProfileScopeTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
        </java>

        <java classname="UuidBatcherTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
        </java>

        <java classname="LegacyStreamsTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
        </java>

        <java classname="ClassicChannelsTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
        </java>

        <java classname="ProfileRedirectTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
            <arg file="${build.dir}/test-stubs"/>
        </java>

        <!-- One process per key source: which one is in play is decided once and cached, so
             running them together would test whichever got there first and nothing else. -->
        <java classname="ProfileSignatureTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
            <arg value="publickeys"/>
            <arg file="${build.dir}/test-stubs"/>
        </java>

        <java classname="ProfileSignatureTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
            <arg value="metadata"/>
            <arg file="${build.dir}/test-stubs"/>
        </java>

        <java classname="ProfileSignatureTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
            <arg value="offline"/>
            <arg file="${build.dir}/test-stubs"/>
        </java>

        <!-- A client that started with checking off, turned on by the server it joined. Its own
             process because the patched classes are patched once, and this one needs them patched
             the way a client without the flag gets them. -->
        <java classname="ProfileSignatureTest" fork="true" failonerror="true"
              jvm="${java_home}/bin/java">
            <classpath refid="test.classpath"/>
            <arg value="declared"/>
            <arg file="${build.dir}/test-stubs"/>
        </java>
    </target>

    <target name="shadow" depends="compile">

        <jar destfile="${temp.dir}/${artifact}-${version}-fat.jar">

            <manifest>
                <attribute name="Premain-Class" value="org.unmojang.loki.Loki"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Can-Redefine-Classes" value="true"/>
                <attribute name="Can-Retransform-Classes" value="true"/>
                <attribute name="AuthlibInjectorAPIServer" value="${authlibInjectorAPIServer}"/>
                <attribute name="AuthHost" value="${authHost}"/>
                <attribute name="AccountHost" value="${accountHost}"/>
                <attribute name="SessionHost" value="${sessionHost}"/>
                <attribute name="ServicesHost" value="${servicesHost}"/>
            </manifest>

            <fileset dir="${classes.dir}">
                <exclude name="META-INF/maven/**"/>
                <exclude name="**/module-info.class"/>
            </fileset>

            <zipfileset src="${lib.dir}/asm-${asm.version}.jar">
                <exclude name="META-INF/**"/>
                <exclude name="**/module-info.class"/>
            </zipfileset>

            <zipfileset src="${lib.dir}/asm-tree-${asm.version}.jar">
                <exclude name="META-INF/**"/>
                <exclude name="**/module-info.class"/>
            </zipfileset>

            <zipfileset src="${lib.dir}/asm-commons-${asm.version}.jar">
                <exclude name="META-INF/**"/>
                <exclude name="**/module-info.class"/>
            </zipfileset>
        </jar>

        <available file="${java_home}/jre/lib/rt.jar" property="proguard.rtjar"/>
        <available file="${java_home}/jmods" type="dir" property="proguard.jmods"/>
        <condition property="proguard.haslibs">
            <or>
                <isset property="proguard.rtjar"/>
                <isset property="proguard.jmods"/>
            </or>
        </condition>

        <java classname="proguard.ProGuard" fork="true" failonerror="true">
            <classpath>
                <fileset dir="${tools.dir}" includes="*.jar"/>
            </classpath>
            <arg value="@proguard.pro"/>
            <arg value="-dontoptimize" unless:set="proguard.haslibs"/>
            <!-- Without platform libraryjars, every java.* reference is unresolved; suppress the noise -->
            <arg value="-dontwarn" unless:set="proguard.haslibs"/>
            <arg value="**" unless:set="proguard.haslibs"/>
            <arg value="-injars"/>
            <arg file="${temp.dir}/${artifact}-${version}-fat.jar"/>
            <arg value="-outjars"/>
            <arg file="${temp.dir}/${artifact}-${version}-shrunk.jar"/>
            <arg value="-libraryjars" if:set="proguard.rtjar"/>
            <arg value="${java_home}/jre/lib/rt.jar" if:set="proguard.rtjar"/>
            <arg value="-libraryjars" if:set="proguard.jmods"/>
            <arg value="${java_home}/jmods/java.base.jmod(!**.jar;!module-info.class)" if:set="proguard.jmods"/>
            <arg value="-libraryjars" if:set="proguard.jmods"/>
            <arg value="${java_home}/jmods/java.instrument.jmod(!**.jar;!module-info.class)" if:set="proguard.jmods"/>
            <arg value="-libraryjars" if:set="proguard.jmods"/>
            <arg value="${java_home}/jmods/java.desktop.jmod(!**.jar;!module-info.class)" if:set="proguard.jmods"/>
            <arg value="-libraryjars" if:set="proguard.jmods"/>
            <arg value="${java_home}/jmods/java.management.jmod(!**.jar;!module-info.class)" if:set="proguard.jmods"/>
        </java>

        <path id="jarjar.classpath">
            <fileset dir="${tools.dir}" includes="jarjar-*.jar"/>
            <fileset dir="${lib.dir}" includes="asm-*.jar"/>
        </path>

        <java classname="org.pantsbuild.jarjar.Main" fork="true" failonerror="true">
            <classpath refid="jarjar.classpath"/>
            <arg value="process"/>
            <arg value="jarjar.rules"/>
            <arg value="${temp.dir}/${artifact}-${version}-shrunk.jar"/>
            <arg value="${dist.dir}/${artifact}-${version}.jar"/>
        </java>

    </target>

    <target name="build" depends="shadow"/>

    <target name="clean" description="Clear build directory">
        <delete dir="${build.dir}"/>
    </target>

    <target name="clean-all" depends="clean" description="Clear build directory + Ivy cache">
        <ivy:cleancache/>
    </target>
</project>
